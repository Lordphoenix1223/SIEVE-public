            "minLength": 1
          },
          "title": "Derivations",
          "type": "object"
        },
        "ended_at": {
          "format": "date-time",
          "title": "Ended At",
          "type": "string"
        },
        "environment_id": {
          "minLength": 1,
          "title": "Environment Id",
          "type": "string"
        },
        "external_service": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "External Service"
        },
        "generated_entity_ids": {
          "items": {
            "minLength": 1,
            "pattern": "^\\S+$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Generated Entity Ids",
          "type": "array"
        },
        "id": {
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Id",
          "type": "string"
        },
        "method_version": {
          "minLength": 1,
          "title": "Method Version",
          "type": "string"
        },
        "random_seeds": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Random Seeds",
          "type": "object"
        },
        "request_parameters": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Request Parameters",
          "type": "object"
        },
        "schema_version": {
          "const": "sieve.v0",
          "default": "sieve.v0",
          "title": "Schema Version",
          "type": "string"
        },
        "software_version": {
          "minLength": 1,
          "title": "Software Version",
          "type": "string"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "used_entity_ids": {
          "items": {
            "minLength": 1,
            "pattern": "^\\S+$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Used Entity Ids",
          "type": "array"
        }
      },
      "required": [
        "id",
        "activity",
        "method_version",
        "agent_ids",
        "used_entity_ids",
        "generated_entity_ids",
        "derivations",
        "code_commit",
        "software_version",
        "configuration",
        "request_parameters",
        "random_seeds",
        "environment_id",
        "started_at",
        "ended_at"
