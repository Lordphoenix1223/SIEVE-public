        "$ref": "#/$defs/ProvenanceRecord"
      },
      "title": "Records",
      "type": "array"
    },
    "schema_version": {
      "const": "sieve.v0",
      "default": "sieve.v0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "entities",
    "agents",
    "records"
