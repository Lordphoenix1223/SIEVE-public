{
  "$defs": {
    "Agent": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "role": {
          "minLength": 1,
          "title": "Role",
          "type": "string"
        },
        "schema_version": {
          "const": "sieve.v0",
          "default": "sieve.v0",
          "title": "Schema Version",
          "type": "string"
        },
        "uri": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Uri"
        }
      },
      "required": [
        "id",
        "name",
        "role"
      ],
      "title": "Agent",
      "type": "object"
    },
    "Entity": {
      "additionalProperties": false,
      "properties": {
        "acknowledgements": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Acknowledgements",
          "type": "array"
        },
        "citations": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Citations",
          "type": "array"
        },
        "dataset_release": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dataset Release"
        },
        "hash_missing_reason": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hash Missing Reason"
        },
        "id": {
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "provider": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider"
        },
        "provider_identifier": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Identifier"
        },
        "schema_version": {
          "const": "sieve.v0",
          "default": "sieve.v0",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "uri": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Uri"
        }
      },
      "required": [
        "id",
        "kind"
      ],
      "title": "Entity",
      "type": "object"
    },
    "JsonValue": {},
    "ProvenanceRecord": {
      "additionalProperties": false,
      "properties": {
        "activity": {
          "minLength": 1,
          "title": "Activity",
          "type": "string"
        },
        "agent_ids": {
          "items": {
            "minLength": 1,
            "pattern": "^\\S+$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Agent Ids",
          "type": "array"
        },
        "code_commit": {
          "minLength": 1,
          "title": "Code Commit",
          "type": "string"
        },
