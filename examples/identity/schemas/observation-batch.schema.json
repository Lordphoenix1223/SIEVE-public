{
  "$defs": {
    "Agent": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "role": {
          "minLength": 1,
          "title": "Role",
          "type": "string"
        },
        "schema_version": {
          "const": "sieve.v0",
          "default": "sieve.v0",
          "title": "Schema Version",
          "type": "string"
        },
        "uri": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Uri"
        }
      },
      "required": [
        "id",
        "name",
        "role"
      ],
      "title": "Agent",
      "type": "object"
    },
    "Entity": {
      "additionalProperties": false,
      "properties": {
        "acknowledgements": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Acknowledgements",
          "type": "array"
        },
        "citations": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Citations",
          "type": "array"
        },
        "dataset_release": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dataset Release"
        },
        "hash_missing_reason": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hash Missing Reason"
        },
        "id": {
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "provider": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider"
        },
        "provider_identifier": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Identifier"
        },
        "schema_version": {
          "const": "sieve.v0",
          "default": "sieve.v0",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "uri": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Uri"
        }
      },
      "required": [
        "id",
        "kind"
      ],
      "title": "Entity",
      "type": "object"
    },
    "JsonValue": {},
    "Measurement": {
      "additionalProperties": false,
      "properties": {
        "covariance": {
          "anyOf": [
            {
              "$ref": "#/$defs/PositionCovariance"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "id": {
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Id",
          "type": "string"
        },
        "method": {
          "$ref": "#/$defs/MethodSpec"
        },
        "observation_id": {
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Observation Id",
          "type": "string"
        },
        "position": {
          "anyOf": [
            {
              "$ref": "#/$defs/SkyPosition"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "provenance_ref": {
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Provenance Ref",
          "type": "string"
        },
        "quality": {
          "$ref": "#/$defs/Quality"
        },
        "quantities": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ScalarMeasurement"
          },
          "title": "Quantities",
          "type": "array"
        },
        "raw_output_asset_ids": {
          "items": {
            "minLength": 1,
            "pattern": "^\\S+$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Raw Output Asset Ids",
          "type": "array"
        },
        "raw_source_id": {
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Raw Source Id",
          "type": "string"
        },
        "schema_version": {
          "const": "sieve.identity.v1",
          "default": "sieve.identity.v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "observation_id",
        "raw_source_id",
        "method",
        "raw_output_asset_ids",
        "provenance_ref"
      ],
      "title": "Measurement",
      "type": "object"
    },
    "MethodSpec": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Name",
          "type": "string"
        },
        "schema_version": {
          "const": "sieve.v0",
          "default": "sieve.v0",
          "title": "Schema Version",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "title": "MethodSpec",
      "type": "object"
    },
    "Observation": {
      "additionalProperties": false,
      "properties": {
        "bandpass_ref": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "^\\S+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bandpass Ref"
        },
        "dependence_group": {
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Dependence Group",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Id",
          "type": "string"
        },
        "observer_ref": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "^\\S+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observer Ref"
        },
        "pointing": {
          "anyOf": [
            {
              "$ref": "#/$defs/SkyPosition"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "provenance_ref": {
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Provenance Ref",
          "type": "string"
        },
        "quality": {
          "$ref": "#/$defs/Quality"
        },
        "raw_asset_ids": {
          "items": {
            "minLength": 1,
            "pattern": "^\\S+$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Raw Asset Ids",
          "type": "array"
        },
        "schema_version": {
          "const": "sieve.identity.v1",
          "default": "sieve.identity.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/SourceKey"
        },
        "time": {
          "$ref": "#/$defs/ObservationTime"
        }
      },
      "required": [
        "id",
        "source",
        "time",
        "dependence_group",
        "raw_asset_ids",
        "provenance_ref"
      ],
      "title": "Observation",
      "type": "object"
    },
    "ObservationTime": {
      "additionalProperties": false,
      "description": "Split Julian date avoids rounding away subsecond precision in one float.",
      "properties": {
        "jd1": {
          "title": "Jd1",
          "type": "number"
        },
        "jd2": {
          "title": "Jd2",
          "type": "number"
        },
        "scale": {
          "enum": [
            "utc",
            "tai",
            "tt",
            "tdb",
            "tcb",
            "tcg",
            "ut1"
          ],
          "title": "Scale",
          "type": "string"
        },
        "schema_version": {
          "const": "sieve.v0",
          "default": "sieve.v0",
          "title": "Schema Version",
          "type": "string"
        },
        "uncertainty_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Uncertainty Seconds"
        }
      },
      "required": [
        "jd1",
        "jd2",
        "scale"
      ],
      "title": "ObservationTime",
      "type": "object"
    },
    "PositionCovariance": {
      "additionalProperties": false,
      "properties": {
        "basis": {
          "const": "tangent_longitude_cos_latitude_latitude",
          "title": "Basis",
          "type": "string"
        },
        "schema_version": {
          "const": "sieve.v0",
          "default": "sieve.v0",
          "title": "Schema Version",
          "type": "string"
        },
        "unit": {
          "default": "arcsec2",
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        },
        "values": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            }
          ],
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "values",
        "basis"
      ],
      "title": "PositionCovariance",
      "type": "object"
    },
    "ProvenanceGraph": {
      "additionalProperties": false,
      "properties": {
        "agents": {
          "items": {
            "$ref": "#/$defs/Agent"
          },
          "title": "Agents",
          "type": "array"
        },
        "entities": {
          "items": {
            "$ref": "#/$defs/Entity"
          },
          "title": "Entities",
          "type": "array"
        },
        "records": {
          "items": {
            "$ref": "#/$defs/ProvenanceRecord"
          },
          "title": "Records",
          "type": "array"
        },
        "schema_version": {
          "const": "sieve.v0",
          "default": "sieve.v0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "entities",
        "agents",
        "records"
      ],
      "title": "ProvenanceGraph",
      "type": "object"
    },
    "ProvenanceRecord": {
      "additionalProperties": false,
      "properties": {
        "activity": {
          "minLength": 1,
          "title": "Activity",
          "type": "string"
        },
        "agent_ids": {
          "items": {
            "minLength": 1,
            "pattern": "^\\S+$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Agent Ids",
          "type": "array"
        },
        "code_commit": {
          "minLength": 1,
          "title": "Code Commit",
          "type": "string"
        },
        "configuration": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Configuration",
          "type": "object"
        },
        "derivations": {
          "patternProperties": {
            "^\\S+$": {
              "items": {
                "minLength": 1,
                "pattern": "^\\S+$",
                "type": "string"
              },
              "type": "array"
            }
          },
          "propertyNames": {
            "minLength": 1
          },
          "title": "Derivations",
          "type": "object"
        },
        "ended_at": {
          "format": "date-time",
          "title": "Ended At",
          "type": "string"
        },
        "environment_id": {
          "minLength": 1,
          "title": "Environment Id",
          "type": "string"
        },
        "external_service": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "External Service"
        },
        "generated_entity_ids": {
          "items": {
            "minLength": 1,
            "pattern": "^\\S+$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Generated Entity Ids",
          "type": "array"
        },
        "id": {
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Id",
          "type": "string"
        },
        "method_version": {
          "minLength": 1,
          "title": "Method Version",
          "type": "string"
        },
        "random_seeds": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Random Seeds",
          "type": "object"
        },
        "request_parameters": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Request Parameters",
          "type": "object"
        },
        "schema_version": {
          "const": "sieve.v0",
          "default": "sieve.v0",
          "title": "Schema Version",
          "type": "string"
        },
        "software_version": {
          "minLength": 1,
          "title": "Software Version",
          "type": "string"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "used_entity_ids": {
          "items": {
            "minLength": 1,
            "pattern": "^\\S+$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Used Entity Ids",
          "type": "array"
        }
      },
      "required": [
        "id",
        "activity",
        "method_version",
        "agent_ids",
        "used_entity_ids",
        "generated_entity_ids",
        "derivations",
        "code_commit",
        "software_version",
        "configuration",
        "request_parameters",
        "random_seeds",
        "environment_id",
        "started_at",
        "ended_at"
      ],
      "title": "ProvenanceRecord",
      "type": "object"
    },
    "Quality": {
      "additionalProperties": false,
      "properties": {
        "bitmask": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bitmask"
        },
        "flag_definition_ref": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Flag Definition Ref"
        },
        "flags": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Flags",
          "type": "array"
        },
        "schema_version": {
          "const": "sieve.v0",
          "default": "sieve.v0",
          "title": "Schema Version",
          "type": "string"
        },
        "usable": {
          "default": true,
          "title": "Usable",
          "type": "boolean"
        }
      },
      "title": "Quality",
      "type": "object"
    },
    "QuantityValue": {
      "additionalProperties": false,
      "properties": {
        "missing_reason": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Missing Reason"
        },
        "schema_version": {
          "const": "sieve.v0",
          "default": "sieve.v0",
          "title": "Schema Version",
          "type": "string"
        },
        "uncertainty": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Uncertainty"
        },
        "unit": {
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "value",
        "unit"
      ],
      "title": "QuantityValue",
      "type": "object"
    },
    "ScalarMeasurement": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Name",
          "type": "string"
        },
        "quantity": {
          "$ref": "#/$defs/QuantityValue"
        },
        "schema_version": {
          "const": "sieve.identity.v1",
          "default": "sieve.identity.v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "quantity"
      ],
      "title": "ScalarMeasurement",
      "type": "object"
    },
    "SkyPosition": {
      "additionalProperties": false,
      "properties": {
        "frame": {
          "enum": [
            "icrs",
            "galactic"
          ],
          "title": "Frame",
          "type": "string"
        },
        "latitude_deg": {
          "maximum": 90,
          "minimum": -90,
          "title": "Latitude Deg",
          "type": "number"
        },
        "longitude_deg": {
          "exclusiveMaximum": 360,
          "minimum": 0,
          "title": "Longitude Deg",
          "type": "number"
        },
        "schema_version": {
          "const": "sieve.v0",
          "default": "sieve.v0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "longitude_deg",
        "latitude_deg",
        "frame"
      ],
      "title": "SkyPosition",
      "type": "object"
    },
    "SourceKey": {
      "additionalProperties": false,
      "properties": {
        "dataset": {
          "minLength": 1,
          "title": "Dataset",
          "type": "string"
        },
        "exposure_id": {
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Exposure Id",
          "type": "string"
        },
        "provider": {
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        },
        "release": {
          "minLength": 1,
          "title": "Release",
          "type": "string"
        },
        "schema_version": {
          "const": "sieve.identity.v1",
          "default": "sieve.identity.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "source_id": {
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Source Id",
          "type": "string"
        }
      },
      "required": [
        "provider",
        "dataset",
        "release",
        "exposure_id",
        "source_id"
      ],
      "title": "SourceKey",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Validate producer records before any proposal/evidence adapter consumes them.",
  "properties": {
    "measurements": {
      "items": {
        "$ref": "#/$defs/Measurement"
      },
      "title": "Measurements",
      "type": "array"
    },
    "observations": {
      "items": {
        "$ref": "#/$defs/Observation"
      },
      "title": "Observations",
      "type": "array"
    },
    "provenance": {
      "$ref": "#/$defs/ProvenanceGraph"
    },
    "schema_version": {
      "const": "sieve.identity.v1",
      "default": "sieve.identity.v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "observations",
    "measurements",
    "provenance"
  ],
  "title": "ObservationBatch",
  "type": "object"
}
